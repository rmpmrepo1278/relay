#!/usr/bin/env bash
# collaborator — cross-agent coordination for Relay/Hermes/OpenCode sessions.
#
# All sessions share ~/.hermes/collaborator-memory. This script gives every
# agent a tiny claim registry so no two agents edit the same subsystem at the
# same time (telegram adapters, omniroute combos, config.yaml, docker state...).
#
# LAYER 1 (git, durable/history): claims + log persisted in state/coordination.json
# LAYER 2 (agentbus, real-time):   publish/presence/objectives/SSE live bus on
#                                  the homelab (default http://127.0.0.1:9107).
#
# Subcommands:
#   sync                     pull --rebase --autostash (do BEFORE any work)
#   status                   show active claims + working_state
#   claim AREA NOTE          claim a work area (owned for max 4h or until done)
#   heartbeat AREA [NOTE]    refresh claim timestamp (still mine, not stale)
#   done AREA [NOTE]         release a claim (record completion note)
#   log AREA MESSAGE         append to a per-area log while keeping control
#   say [CHANNEL] MESSAGE    publish a message on the live bus
#   presence KIND [NOTE]     announce kind (up|idle|working|done) on the bus
#   goal                      list objectives
#   goal add KEY TITLE       add an objective
#   goal status KEY STATE    mark an objective open|in_progress|done
#   bus status|events|ping   inspect the live bus
#   bus listen [SECONDS]     stream SSE events (real-time, blocks)
#
# Exit codes: 0 ok, 1 usage/error, 2 area claimed by someone else.
set -euo pipefail

REPO="${COLLABORATOR_REPO:-$HOME/.hermes/collaborator-memory}"
STATE_FILE="$REPO/state/coordination.json"
PROTO="state/coordination.json"

# --- agentbus (real-time) ----------------------------------------------------
BUS_URL="${AGENTBUS_URL:-http://127.0.0.1:9107}"
_http() { # _http METHOD PATH JSONBODY-or-EMPTY
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -s -m 5 -X "$method" "$BUS_URL$path" -H "Content-Type: application/json" -d "$body"
  else
    curl -s -m 5 -X "$method" "$BUS_URL$path"
  fi
}

# Who am I? Prefer explicit env, else last agent app, else hostname.
OWNER="${COLLABORATOR_OWNER:-}"
if [ -z "$OWNER" ]; then
  OWNER="${ARGOS_AGENT_NAME:-}"
fi
if [ -z "$OWNER" ]; then
  OWNER="$(hostname -s 2>/dev/null || echo unknown)"
fi
OWNER="${OWNER}-opencode"

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

die() { echo "collaborator: $*" >&2; exit 1; }

cmd_sync() {
  ( cd "$REPO" && git pull --rebase --autostash )
  echo "collaborator: synced $REPO"
}

cmd_status() {
  local busclaims=""
  busclaims=$(_http GET /status 2>/dev/null | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    c=d.get('claims',{})
    for area in sorted(c):
        cl=c[area]
        print(f'{area} :: {cl.get(\"owner\",\"?\")} :: {cl.get(\"note\",\"\")}')
except Exception:
    pass
" 2>/dev/null || true)
  if [ -n "$busclaims" ]; then
    echo "== LIVE bus claims (agentbus :9107) =="
    echo "$busclaims"
    echo
  fi
  [ -f "$STATE_FILE" ] || { echo "no active claims (git layer)"; return 0; }
  python3 - "$STATE_FILE" <<'PYEOF'
import json, sys, datetime
p = sys.argv[1]
try:
    data = json.load(open(p))
except Exception as e:
    print(f"(unreadable: {e})")
    sys.exit(0)
claims = data.get("claims", {})
if not claims:
    print("no active claims (git layer)")
else:
    now = datetime.datetime.now(datetime.timezone.utc)
    print("== git-layer claims ==")
    print(f"{'AREA':30s} {'OWNER':28s} {'AGE':>8s}  NOTE")
    for area, c in sorted(claims.items()):
        try:
            ts = datetime.datetime.fromisoformat(c["updated_at"].replace("Z", "+00:00"))
            age = now - ts
            ages = f"{int(age.total_seconds()//60)}m"
            stale = " STALE" if age > datetime.timedelta(hours=4) else ""
        except Exception:
            ages, stale = "?", ""
        print(f"{area:30s} {c.get('owner','?'):28s} {ages:>8s}  {c.get('note','')}{stale}")
state = data.get("working_state") or {}
if state.get("device"):
    print(f"\nworking_state: {state.get('device')} updated {state.get('updated_at','?')}")
    for pr in state.get("priorities", [])[:5]:
        print(f"  priority: {pr.get('priority','?')} {pr.get('title','')}")
PYEOF
}

_ensure_state() {
  mkdir -p "$(dirname "$STATE_FILE")"
  [ -f "$STATE_FILE" ] || echo '{"claims":{}}' > "$STATE_FILE"
}

_write_claim() {
  python3 - "$STATE_FILE" "$OWNER" "$1" "$2" "$3" <<'PYEOF'
import json, os, sys, datetime
p, owner, area, note, ts = sys.argv[1:6]
data = json.load(open(p))
data.setdefault("claims", {})
data["claims"][area] = {"owner": owner, "updated_at": ts, "note": note}
json.dump(data, open(p, "w"), indent=2, sort_keys=True)
PYEOF
}

_stale_ok() {
  # returns 0 if the claim owner differs AND the claim is stale (>4h)
  python3 - "$STATE_FILE" "$OWNER" "$1" <<'PYEOF'
import json, sys, datetime
p, owner, area = sys.argv[1:4]
data = json.load(open(p))
c = data.get("claims", {}).get(area)
if not c or c.get("owner") == owner:
    sys.exit(0)
try:
    ts = datetime.datetime.fromisoformat(c["updated_at"].replace("Z", "+00:00"))
    stale = (datetime.datetime.now(datetime.timezone.utc) - ts) > datetime.timedelta(hours=4)
except Exception:
    stale = False
sys.exit(1 if stale else 2)
PYEOF
  return $?
}

cmd_claim() {
  local area="$1"; shift
  local note="$*"
  _ensure_state
  if [ -f "$STATE_FILE" ]; then
    if grep -q "\"$area\"" "$STATE_FILE"; then
      if _stale_ok "$area"; then
        echo "collaborator: taking over STALE claim on '$area'"
      else
        local other
        other=$(python3 - "$STATE_FILE" "$area" <<'PYEOF'
import json, sys
p, area = sys.argv[1:3]
data = json.load(open(p))
c = data.get("claims", {}).get(area, {})
print(f"{c.get('owner','?')}: {c.get('note','')} (updated {c.get('updated_at','?')})")
PYEOF
)
        echo "collaborator: area '$area' already claimed by $other" >&2
        exit 2
      fi
    fi
  fi
  _write_claim "$area" "$note" "$(now)"
  ( cd "$REPO" && git add state/coordination.json >/dev/null 2>&1 && git commit -m "coordination: claim $area ($OWNER)" >/dev/null 2>&1 && git push >/dev/null 2>&1 ) || true
  _http POST /claim "{\"area\":\"$area\",\"owner\":\"$OWNER\",\"note\":\"$note\",\"do\":\"claim\"}" >/dev/null 2>&1 || true
  echo "collaborator: claimed '$area' (owner=$OWNER)"
}

cmd_done() {
  local area="$1"; shift
  local note="$*"
  _ensure_state
  python3 - "$STATE_FILE" "$area" <<'PYEOF'
import json, sys, datetime
p, area = sys.argv[1:3]
data = json.load(open(p))
c = data.get("claims", {}).pop(area, None)
if c:
    data.setdefault("history", []).append({**c, "released_at": datetime.datetime.now(datetime.timezone.utc).isoformat(), "note2": ""})
json.dump(data, open(p, "w"), indent=2, sort_keys=True)
PYEOF
  ( cd "$REPO" && git add state/coordination.json >/dev/null 2>&1 && git commit -m "coordination: done $area${note:+ ($note)}" >/dev/null 2>&1 && git push >/dev/null 2>&1 ) || true
  _http POST /claim "{\"area\":\"$area\",\"owner\":\"$OWNER\",\"do\":\"release\"}" >/dev/null 2>&1 || true
  echo "collaborator: released '$area'"
}

cmd_log() {
  local area="$1"; shift
  local msg="$*"
  _ensure_state
  python3 - "$STATE_FILE" "$area" "$OWNER" "$msg" "$(now)" <<'PYEOF'
import json, sys
p, area, owner, msg, ts = sys.argv[1:6]
data = json.load(open(p))
data.setdefault("log", []).insert(0, {"area": area, "owner": owner, "at": ts, "msg": msg})
data["log"] = data["log"][:100]
json.dump(data, open(p, "w"), indent=2, sort_keys=True)
PYEOF
  ( cd "$REPO" && git add state/coordination.json >/dev/null 2>&1 && git commit -m "coordination: log $area" >/dev/null 2>&1 && git push >/dev/null 2>&1 ) || true
  echo "collaborator: logged '$area': $msg"
}

cmd_say() {
  local channel="${1:-general}"; shift
  local text="$*"
  [ -n "$text" ] || text="(ping)"
  _http POST /publish "{\"channel\":\"$channel\",\"type\":\"msg\",\"from\":\"$OWNER\",\"text\":\"$text\"}" >/dev/null 2>&1 || { echo "collaborator: bus unreachable at $BUS_URL" >&2; exit 1; }
  echo "collaborator: said [$channel] $text"
}

cmd_presence() {
  local kind="${1:-up}"; shift
  local note="$*"
  _http POST /presence "{\"agent\":\"$OWNER\",\"kind\":\"$kind\",\"note\":\"$note\"}" >/dev/null 2>&1 || { echo "collaborator: bus unreachable at $BUS_URL" >&2; exit 1; }
  echo "collaborator: presence $kind ($note)"
}

cmd_goal() {
  local op="${1:-list}"
  case "$op" in
    list)
      _http GET /status 2>/dev/null | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    o=d.get('objectives',{})
    if not o:
        print('no objectives yet (use: collaborator goal add KEY TITLE)')
    for k,v in sorted(o.items()):
        print(f\"{k}: [{v.get('status','open')}] {v.get('title','')}{'  (owner '+v.get('owner','')+')' if v.get('owner') else ''}\")
except Exception as e:
    print('bus unreachable or unparseable')
" 2>/dev/null
      ;;
    add)
      local key="$2" title="${3:-$2}"
      _http POST /objectives "{\"op\":\"add\",\"key\":\"$key\",\"title\":\"$title\",\"status\":\"open\",\"owner\":\"$OWNER\"}" >/dev/null 2>&1 || { echo "collaborator: bus unreachable" >&2; exit 1; }
      echo "collaborator: objective added '$key'"
      ;;
    status)
      local key="$2" st="$3"
      [ -n "$st" ] || die "usage: collaborator goal status KEY open|in_progress|done"
      _http POST /objectives "{\"op\":\"status\",\"key\":\"$key\",\"status\":\"$st\",\"owner\":\"$OWNER\"}" >/dev/null 2>&1 || { echo "collaborator: bus unreachable" >&2; exit 1; }
      echo "collaborator: objective '$key' -> $st"
      ;;
    *) die "usage: collaborator goal {list|add KEY TITLE|status KEY STATE}" ;;
  esac
}

cmd_bus() {
  case "${1:-status}" in
    status) _http GET /status ;;
    events) _http GET "/events?after=${2:-0}" ;;
    ping) echo "bus: $BUS_URL -> $(_http GET /status | head -c 120)" ;;
    listen)
      echo "listening on $BUS_URL/stream (ctrl-c to stop)..."
      curl -s -N -m "${2:-300}" "$BUS_URL/stream"
      ;;
    *) echo "usage: collaborator bus {status|events|ping|listen}" ;;
  esac
}

USAGE="usage: collaborator {sync|status|claim AREA NOTE|heartbeat AREA [NOTE]|done AREA [NOTE]|log AREA MSG|say [CHANNEL] MSG|presence KIND [NOTE]|goal|bus}"
[ $# -ge 1 ] || die "$USAGE"
case "$1" in
  sync) cmd_sync ;;
  status) cmd_status ;;
  claim) [ $# -ge 2 ] || die "$USAGE"; cmd_claim "${@:2}" ;;
  heartbeat)
    [ $# -ge 2 ] || die "$USAGE"
    _ensure_state
    _write_claim "$2" "${3:-still working}" "$(now)"
    ( cd "$REPO" && git add state/coordination.json >/dev/null 2>&1 && git commit -m "coordination: heartbeat $2" >/dev/null 2>&1 && git push >/dev/null 2>&1 ) || true
    _http POST /claim "{\"area\":\"$2\",\"owner\":\"$OWNER\",\"note\":\"${3:-still working}\",\"do\":\"claim\"}" >/dev/null 2>&1 || true
    echo "collaborator: heartbeat '$2'"
    ;;
  done) [ $# -ge 2 ] || die "$USAGE"; cmd_done "${@:2}" ;;
  log) [ $# -ge 2 ] || die "$USAGE"; cmd_log "${@:2}" ;;
  say) cmd_say "${@:2}" ;;
  presence) cmd_presence "${@:2}" ;;
  goal) cmd_goal "${@:2}" ;;
  bus) cmd_bus "${@:2}" ;;
  *) die "$USAGE" ;;
esac